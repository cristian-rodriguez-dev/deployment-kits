apiVersion: 1

datasources:
  - name: wazuh
    uid: wazuh
    type: grafana-opensearch-datasource
    access: proxy
    url: https://wazuh.indexer:9200
    isDefault: false
    basicAuth: true
    basicAuthUser: admin
    jsonData:
      database: wazuh-alerts-*
      flavor: opensearch
      timeField: '@timestamp'
      tlsAuthWithCACert: true
      tlsSkipVerify: false
    secureJsonData:
      basicAuthPassword: {{ var_wazuh_admin_password | to_json }}
      tlsCACert: {{ var_wazuh_indexer_ca | to_json }}
