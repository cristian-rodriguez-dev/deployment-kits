global:
  scrape_interval: {{ var_prometheus_scrape_interval | to_json }}

scrape_config_files:
  - /etc/prometheus/scrape.d/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node-exporter-local
    static_configs:
      - targets: ["node-exporter:{{ var_node_exporter_port }}"]
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}

  - job_name: node-exporter-remotos
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/node-exporters.yml
        refresh_interval: 30s

  - job_name: docker-cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
