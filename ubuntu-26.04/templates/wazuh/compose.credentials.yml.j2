services:
  wazuh.indexer:
    networks:
      default: {}
      metricas:
        aliases:
          - wazuh.indexer
  wazuh.manager:
    environment:
      INDEXER_PASSWORD: {{ var_wazuh_admin_password | replace('$', '$$') | to_json }}
      API_PASSWORD: {{ var_wazuh_api_password | replace('$', '$$') | to_json }}

  wazuh.dashboard:
    environment:
      INDEXER_PASSWORD: {{ var_wazuh_admin_password | replace('$', '$$') | to_json }}
      API_PASSWORD: {{ var_wazuh_api_password | replace('$', '$$') | to_json }}

networks:
  metricas:
    name: {{ var_monitorizacion_network | to_json }}
    external: true
