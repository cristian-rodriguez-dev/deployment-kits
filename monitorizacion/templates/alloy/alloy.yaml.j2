---
apiVersion: helm.cattle.io/v1
kind: HelmChart

metadata:
  name: alloy
  namespace: kube-system

spec:
  repo: https://grafana.github.io/helm-charts
  chart: alloy
  version: {{ var_alloy_chart_version | to_json }}

  targetNamespace: {{ var_alloy_namespace | to_json }}
  createNamespace: true
  failurePolicy: retry

  valuesContent: |-
    # ============================================================
    # POD SECURITY
    # ============================================================

    global:
      podSecurityContext:
        fsGroup: 473

    # ============================================================
    # ALLOY - KUBERNETES ONLY
    # ============================================================

    alloy:
      enableReporting: false

      # La imagen oficial incluye el usuario alloy 473:473.
      securityContext:
        runAsUser: 473
        runAsGroup: 473
        runAsNonRoot: true

        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true

        capabilities:
          drop:
            - ALL

        seccompProfile:
          type: RuntimeDefault

      # Directorio escribible aislado dentro del pod.
      storagePath: /var/lib/alloy/data

      mounts:
        varlog: false
        dockercontainers: false

        extra:
          - name: alloy-storage
            mountPath: /var/lib/alloy

      # ==========================================================
      # CONFIGURACIÓN ALLOY
      # ==========================================================

      configMap:
        create: true
        content: |-
          logging {
            level  = "info"
            format = "logfmt"
          }

          // ======================================================
          // DESCUBRIMIENTO DE PODS
          // ======================================================

          discovery.kubernetes "pods" {
            role = "pod"
          }

          // ======================================================
          // LABELS
          // ======================================================

          discovery.relabel "kubernetes_pods" {
            targets = discovery.kubernetes.pods.targets

            rule {
              source_labels = ["__meta_kubernetes_namespace"]
              target_label  = "namespace"
              action        = "replace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_name"]
              target_label  = "pod"
              action        = "replace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_container_name"]
              target_label  = "container"
              action        = "replace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_node_name"]
              target_label  = "node"
              action        = "replace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
              target_label  = "app"
              action        = "replace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_container_name"]
              target_label  = "service_name"
              action        = "replace"
            }
          }

          // ======================================================
          // LOGS DE KUBERNETES
          // ======================================================

          loki.source.kubernetes "pods" {
            targets    = discovery.relabel.kubernetes_pods.output
            forward_to = [loki.write.local.receiver]
          }

          // ======================================================
          // LOKI
          // ======================================================

          loki.write "local" {
            external_labels = {
              cluster   = "k3s-lab",
              collector = "alloy-kubernetes",
            }

            endpoint {
              url = "http://loki-gateway.logging.svc.cluster.local/loki/api/v1/push"
            }
          }

      resources:
        requests:
          cpu: 50m
          memory: 128Mi

        limits:
          cpu: 300m
          memory: 512Mi

    # ============================================================
    # CONTROLADOR
    # ============================================================

    controller:
      type: deployment
      replicas: 1

      volumes:
        extra:
          - name: alloy-storage
            emptyDir: {}

    # ============================================================
    # SERVICIO
    # ============================================================

    service:
      enabled: true
      type: ClusterIP