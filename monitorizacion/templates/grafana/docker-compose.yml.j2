services:
  grafana:
    image: {{ var_grafana_image | to_json }}
    user: "472:472"
    restart: unless-stopped

    ports:
      - "{{ var_grafana_port }}:3000"

    environment:
      GF_SECURITY_ADMIN_USER: {{ var_grafana_admin_user | replace('$', '$$') | to_json }}
      GF_SECURITY_ADMIN_EMAIL: {{ var_grafana_admin_email | replace('$', '$$') | to_json }}
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"

    volumes:
      - "{{ var_grafana_install_dir }}/data:/var/lib/grafana"
      - "{{ var_grafana_install_dir }}/provisioning:/etc/grafana/provisioning:ro"
      - "{{ var_grafana_install_dir }}/secrets/admin_password:/run/secrets/grafana_admin_password:ro"

    networks:
      - red_monitorizacion

networks:
  red_monitorizacion:
    name: {{ var_monitorizacion_network | to_json }}
    external: true