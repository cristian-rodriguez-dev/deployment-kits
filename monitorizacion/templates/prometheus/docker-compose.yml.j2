services:
  prometheus:
    image: {{ var_prometheus_image | to_json }}
    user: "65534:65534"
    restart: unless-stopped

    ports:
      - "{{ var_prometheus_port }}:9090"

    extra_hosts:
      - "host.docker.internal:host-gateway"

    volumes:
      # Configuración de Prometheus
      - "{{ var_prometheus_install_dir }}/prometheus:/etc/prometheus:ro"

      # Datos persistentes de Prometheus
      - "{{ var_prometheus_install_dir }}/data:/prometheus"

      # Credenciales para acceder a K3s / kubelet / cAdvisor
      - "{{ var_prometheus_kubernetes_credentials_dir }}:/etc/prometheus-kubernetes:ro"

    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ var_prometheus_retention }}"

    networks:
      red_monitorizacion:
        aliases:
          - prometheus

    depends_on:
      - node-exporter

  node-exporter:
    image: {{ var_node_exporter_image | to_json }}
    restart: unless-stopped

    network_mode: host
    pid: host

    volumes:
      - "/:/host:ro,rslave"

    command:
      - "--path.rootfs=/host"
      - "--web.listen-address=:{{ var_node_exporter_port }}"

networks:
  red_monitorizacion:
    name: {{ var_monitorizacion_network | to_json }}
    external: true