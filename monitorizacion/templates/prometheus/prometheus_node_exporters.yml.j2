global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node-exporter-remotos"
    static_configs:
{% for host in groups['monitoring-agents'] %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ hostvars[host].node_exporter_port | default(node_exporter_default_port) }}"
        labels:
          nodename: "{{ host }}"
          departamento: "{{ hostvars[host].departamento | default('sin-departamento') | replace(' ', '-') }}"
{% endfor %}