global:
  scrape_interval: {{ var_prometheus_scrape_interval | to_json }}

scrape_configs:
  # ============================================================
  # PROMETHEUS
  # ============================================================

  - job_name: "prometheus"
    static_configs:
      - targets:
          - "localhost:9090"

  # ============================================================
  # NODE EXPORTER LOCAL
  # ============================================================

  - job_name: "node-exporter-local"
    static_configs:
      - targets:
          - "host.docker.internal:{{ var_node_exporter_port }}"
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}

  # ============================================================
  # TRAEFIK
  # ============================================================

  - job_name: "traefik"
    static_configs:
      - targets:
          - "host.docker.internal:{{ var_traefik_metrics_port }}"
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}
          service: "traefik"

  # ============================================================
  # KUBE-STATE-METRICS
  # ============================================================

  - job_name: "kube-state-metrics"
    static_configs:
      - targets:
          - "host.docker.internal:{{ var_kube_state_metrics_nodeport }}"
         labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}
          service: "kube-state-metrics"

  # ============================================================
  # KUBELET / CADVISOR
  # CPU Y RAM DE PODS Y CONTENEDORES
  # ============================================================

  - job_name: "kubelet-cadvisor"

    scheme: https

    metrics_path: "/api/v1/nodes/{{ var_k3s_node_name }}/proxy/metrics/cadvisor"

    authorization:
      type: Bearer
      credentials_file: /etc/prometheus-kubernetes/kubelet.token

    tls_config:
      ca_file: /etc/prometheus-kubernetes/k3s-ca.crt

    static_configs:
      - targets:
          - "{{ var_k3s_api_address }}:6443"
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}
          service: "kubelet-cadvisor"

  # ============================================================
  # DOCKER / CADVISOR
  # CPU Y RAM DE CONTENEDORES DOCKER
  # ============================================================

  - job_name: "docker-cadvisor"
    static_configs:
      - targets:
          - "cadvisor:8080"
        labels:
          nodename: {{ var_prometheus_local_name | to_json }}
          departamento: {{ var_prometheus_local_department | to_json }}
          ip: {{ (ansible_host | default(inventory_hostname)) | to_json }}
          service: "docker-cadvisor"

  # ============================================================
  # DEPARTAMENTOS DEFINIDOS MANUALMENTE
  # ============================================================

{% for var_departamento in var_prometheus_departamentos %}
  - job_name: {{ var_departamento.nombre | to_json }}
    static_configs:
{% if var_departamento.equipos | length == 0 %}
      []
{% else %}
{% for var_equipo in var_departamento.equipos %}
      - targets:
          - {{ (var_equipo.direccion ~ ':' ~ (var_equipo.puerto | default(9100) | string)) | to_json }}
        labels:
          nodename: {{ var_equipo.nombre | to_json }}
{% endfor %}
{% endif %}
{% endfor %}

  # ============================================================
  # AGENTES GENERADOS DESDE EL INVENTARIO DE AWX
  # ============================================================

{% set var_inventory_agents = [] %}
{% for var_host in groups.get('monitoring-agents', []) | sort %}
{% set var_agent = hostvars[var_host] %}
{% set var_unused = var_inventory_agents.append({
  'nombre': var_agent.var_prometheus_agent_name | default(var_host),
  'direccion': var_agent.var_prometheus_target_address | default(var_agent.ansible_host | default(var_host)),
  'puerto': var_agent.var_node_exporter_port | default(9100),
  'departamento': var_agent.var_prometheus_department | default('Sin-departamento')
}) %}
{% endfor %}

{% for var_department, var_agents in var_inventory_agents | groupby('departamento') %}
  - job_name: {{ ('inventario-' ~ var_department) | to_json }}
    static_configs:
{% for var_agent in var_agents %}
      - targets:
          - {{ (var_agent.direccion ~ ':' ~ (var_agent.puerto | string)) | to_json }}
        labels:
          nodename: {{ var_agent.nombre | to_json }}
          departamento: {{ var_department | to_json }}
          ip: {{ var_agent.direccion | to_json }}
{% endfor %}
{% endfor %}